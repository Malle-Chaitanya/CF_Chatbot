# Copy to .env and fill with your values. Do not commit .env.

# Weaviate (use http://localhost:8081 when running app on host; backend in Docker uses weaviate:8080)
WEAVIATE_URL=http://localhost:8081

# OpenAI (required for embeddings and optional LLM)
OPENAI_API_KEY=your-openai-api-key

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small

# Chunking
CHUNK_TARGET_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# Retrieval
RETRIEVAL_TOP_K=10

# LLM (for query answering)
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Optional: LangSmith (tracing)
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=rag-phase1

# Parent-document expansion
ENABLE_PARENT_DOC_EXPANSION=false

# Enable/Disable data sources (blog from web, Jira from API)
# ENABLE_WEB_SOURCE=false
# ENABLE_JIRA_SOURCE=true

# Jira (API-based ingestion; only when ENABLE_JIRA_SOURCE=true)
JIRA_SERVER=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEYS=PRI
# Ingest: only tickets with these statuses; past N months (0 = no date filter); max tickets per run (0 = no limit).
JIRA_INGEST_STATUSES=Resolved,Closed
JIRA_INGEST_PAST_MONTHS=2
JIRA_INGEST_MAX_TICKETS=1000
